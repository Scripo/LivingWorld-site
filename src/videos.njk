---
layout: base.njk
title: Videos
permalink: /videos/
pageClass: videos
description: Short videos about LivingWorld and the stories its simulation creates.
---
<header class="page-header wrap narrow">
  <p class="eyebrow">Videos</p>
  <h1>Stories from the simulation</h1>
  <p class="lede">Short videos about LivingWorld’s development and the histories its world creates.{% if site.youtubeChannel %} <a href="{{ site.youtubeChannel }}">Subscribe on YouTube</a>.{% endif %}</p>
</header>

<section class="wrap">
  {%- if videos.length %}
  <div class="shorts-grid">
    {%- for v in videos %}
    <figure class="short">
      <button class="short-frame" type="button" data-video="{{ v.id }}" aria-label="Play: {{ v.title }}">
        <img src="https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg" alt="" loading="lazy" decoding="async">
        <span class="play" aria-hidden="true"></span>
      </button>
      <figcaption>{{ v.title }}</figcaption>
    </figure>
    {%- endfor %}
  </div>
  <script>
    // Load the YouTube player only when a video is clicked, to keep the page fast.
    document.querySelectorAll(".short-frame").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var f = document.createElement("iframe");
        f.src = "https://www.youtube-nocookie.com/embed/" + btn.dataset.video + "?autoplay=1&rel=0";
        f.title = btn.getAttribute("aria-label");
        f.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
        f.allowFullscreen = true;
        btn.replaceWith(f);
      });
    });
  </script>
  {%- else %}
  <div class="empty panel narrow">
    <h2>The first short is in the works</h2>
    <p>Videos will appear here as soon as they’re published. Follow the devlog to hear when the first one lands.</p>
    <a class="btn" href="/subscribe/">Follow development</a>
  </div>
  {%- endif %}
</section>
