<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " · " + site.title) if title and title != site.title else (site.title + " · " + site.tagline) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
  <meta property="og:image" content="{{ siteUrl }}assets/img/concept/camp-hero.jpg">
  <meta name="theme-color" content="#121110">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }} Devlog" href="/feed.xml">
  <link rel="preload" href="/assets/fonts/cinzel-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/alegreya-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="page-{{ pageClass or 'default' }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        {% include "logo.svg" %}
        <span>{{ site.title }}</span>
      </a>
      <nav class="site-nav" aria-label="Main">
        {%- set nav = [["/", "Home"], ["/about/", "The Game"], ["/devlog/", "Devlog"], ["/videos/", "Videos"]] %}
        {%- for item in nav %}
        <a href="{{ item[0] }}"{% if page.url == item[0] or (item[0] != "/" and page.url.startsWith(item[0])) %} aria-current="page"{% endif %}>{{ item[1] }}</a>
        {%- endfor %}
        <a class="nav-cta" href="/subscribe/"{% if page.url == "/subscribe/" %} aria-current="page"{% endif %}>Follow</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        {% include "logo.svg" %}
        <div>
          <p class="footer-title">{{ site.title }}</p>
          <p class="muted">A fantasy world simulation in early development.</p>
        </div>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/subscribe/">Email updates</a>
        <a href="/feed.xml">RSS feed</a>
        {% if site.youtubeChannel %}<a href="{{ site.youtubeChannel }}">YouTube</a>{% endif %}
      </nav>
    </div>
    <div class="wrap">
      <p class="fineprint">Images marked “Concept art” show intended direction, not the current game. © {{ year }} {{ site.author }}.</p>
    </div>
  </footer>
</body>
</html>
